{
  "name": "event-management-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Orbit — a 3D event management portal built with React, Three.js, Express and SQLite.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"node --watch server/index.js\" \"vite\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
